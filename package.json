{
  "name": "rewind-cli",
  "version": "1.0.1",
  "description": "Verified failure memory for coding agents with selective recall and disciplined abstention.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "rewind": "bin/rewind.js"
  },
  "mcp": {
    "command": "npx",
    "args": [
      "-y",
      "rewind-cli",
      "mcp"
    ]
  },
  "files": [
    "bin/",
    "src/",
    "dist/",
    "LICENSE",
    "README.md",
    "AGENT_INTERFACE.md"
  ],
  "scripts": {
    "test": "node --test",
    "build": "node scripts/update-proofs.js && node scripts/build.js",
    "update-proofs": "node scripts/update-proofs.js",
    "verify:build": "node --test test/build.test.js",
    "check": "node --check bin/rewind.js",
    "lint": "node --check bin/rewind.js scripts/build.js scripts/update-proofs.js",
    "prepack": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tejas3479/rewind-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Tejas3479/rewind-cli/issues"
  },
  "homepage": "https://github.com/Tejas3479/rewind-cli#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "cli",
    "terminal",
    "recovery",
    "debugging",
    "error-tracking",
    "ledger",
    "zero-dependency",
    "developer-tools",
    "devtools",
    "dx",
    "mcp",
    "ai-agent"
  ],
  "author": "Tejas3479 <tejas38293@gmail.com>",
  "license": "MIT"
}
